{
  "name": "taskmon",
  "version": "0.1.0",
  "description": "Joguinho idle de criaturas na barra de tarefas",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
